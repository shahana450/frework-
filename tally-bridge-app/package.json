{
  "name": "frework-tally-bridge",
  "version": "1.0.0",
  "description": "Connects FreWork Finance to Tally Prime on your computer",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "selfsigned": "^2.4.1"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "online.frework.tally-bridge",
    "productName": "FreWork Tally Bridge",
    "copyright": "Copyright 2026 FreWork",
    "files": ["main.js", "node_modules/**/*"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "requestedExecutionLevel": "asInvoker"
    }
  },
  "allowScripts": {
    "electron@31.7.7": true
  }
}
