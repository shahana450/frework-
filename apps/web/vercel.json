{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/wa-health",
      "schedule": "30 3 * * *"
    },
    {
      "path": "/api/cron/warm",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 * * * *"
    }
  ]
}
